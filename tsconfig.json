{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2023"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  // The build ships the app only. Test files are colocated with sources, so
  // they are excluded here and typechecked by tsconfig.test.json instead.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
