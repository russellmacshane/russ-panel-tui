{
  "name": "@rmacshane-lw/russ-panel-tui",
  "version": "0.1.0",
  "description": "An Ink/React terminal UI command center, starting with a live weather panel.",
  "keywords": ["tui", "cli", "terminal", "ink", "react", "weather", "command-center"],
  "author": "Russ MacShane",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/russellmacshane/russ-panel-tui.git"
  },
  "bugs": {
    "url": "https://github.com/russellmacshane/russ-panel-tui/issues"
  },
  "homepage": "https://github.com/russellmacshane/russ-panel-tui#readme",
  "type": "module",
  "bin": {
    "russ-panel": "./dist/cli.js"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "typecheck": "tsc --project tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "ink": "^7.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  }
}
